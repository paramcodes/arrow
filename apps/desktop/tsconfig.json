{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../../packages/types" },
    { "path": "../../packages/theme" },
    { "path": "../../packages/editor-core" },
    { "path": "../../packages/ui" }
  ]
}
