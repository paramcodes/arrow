{
  "name": "arrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arrow, an AI-native code editor built with Tauri v2, React 19 and Vite.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint . && eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "harness": "node scripts/harness-score.mjs",
    "prove": "node scripts/prove-guardrails.mjs",
    "arch": "eslint --config eslint.arch.mjs . --max-warnings=0",
    "prepare": "pnpm exec lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
