{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.tsbuild/**",
    "**/target/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/.worktrees/**"
  ],
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
